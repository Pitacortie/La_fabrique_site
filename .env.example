# Copier ce fichier en .env puis adapter les valeurs.

# Base PostgreSQL (docker compose up -d fournit celle-ci)
DATABASE_URL="postgresql://fabrique:fabrique@localhost:5432/fabrique?schema=public"

# URL publique du site (liens d'activation dans les courriels)
APP_URL="http://localhost:3000"

# Courriels : Mailpit en local (interface sur http://localhost:8025)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="La Fabrique de Ménesplet <contact@menesplet-fabrique.fr>"

# Premier compte Bureau créé par le seed (npm run db:seed)
SEED_ADMIN_EMAIL="admin@example.org"
SEED_ADMIN_PASSWORD="change-moi-tout-de-suite"
