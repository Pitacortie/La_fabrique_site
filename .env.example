# Copier ce fichier en .env puis adapter les valeurs.

# Base PostgreSQL (docker compose up -d fournit celle-ci)
DATABASE_URL="postgresql://fabrique:fabrique@localhost:5432/fabrique?schema=public"

# URL publique du site (liens d'activation dans les courriels)
APP_URL="http://localhost:3000"

# Courriels (SMTP). Laisser SMTP_HOST vide : les courriels sont affichés dans le terminal au lieu d'être envoyés.
# Exemple Brevo : SMTP_HOST="smtp-relay.brevo.com", SMTP_PORT="587", identifiants dans Brevo > SMTP & API.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="La Fabrique de Ménesplet <contact@lafabriquedemenesplet.fr>"

# Premier compte Bureau créé par le seed (npm run db:seed)
SEED_ADMIN_EMAIL="admin@example.org"
SEED_ADMIN_PASSWORD="change-moi-tout-de-suite"

# Tâches quotidiennes (rappels de cotisation, ménage) : secret partagé avec le planificateur
# (.github/workflows/taches-quotidiennes.yml). 16 caractères minimum.
TACHES_SECRET="a-remplacer-par-une-longue-valeur-aleatoire"
