// Modèle de données de La Fabrique de Ménesplet (cahier des charges v0.9, section 9).
// Phase 1 : adhésions, membres, textes acceptés, cotisations, contenus, actualités.
// Le SEL (annonces, messagerie, briques) viendra en phase 2 ; l'alias est déjà en place.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Énumérations ----------

enum StatutDemande {
  EN_ATTENTE
  VALIDEE
  REFUSEE
  CLASSEE_SANS_SUITE
}

enum StatutMembre {
  EN_ATTENTE_ACTIVATION // compte créé, mot de passe pas encore choisi
  ACTIF
  SUSPENDU
  CLOTURE
}

// Statuts, art. 7
enum CategorieMembre {
  FONDATEUR
  ACTIF
  ADHERENT
  BIENFAITEUR
}

// Droits sur le site. BUREAU inclut les droits ADMINISTRATEUR.
enum Role {
  ADHERENT
  ADMINISTRATEUR
  BUREAU
}

enum ModeReglement {
  CHEQUE
  ESPECES
  VIREMENT
  WERO_PAYLIB
}

enum TypeTexte {
  STATUTS
  REGLEMENT_INTERIEUR
  CHARTE_NEUTRALITE
  BULLETIN_ADHESION
  CHARTE_SEL
  REGLEMENT_SEL
}

enum TypeJeton {
  ACTIVATION
  REINITIALISATION
  CHANGEMENT_EMAIL
}

enum StatutArticle {
  BROUILLON
  PUBLIE
  RETIRE
}

enum StatutMessage {
  NOUVEAU
  EN_COURS
  TRAITE
}

// ---------- Adhésion ----------

// ADH-1 à ADH-4 : une demande ne crée ni compte ni mot de passe.
model DemandeAdhesion {
  id String @id @default(cuid())

  email         String
  nom           String
  prenom        String
  dateNaissance DateTime @db.Date
  adresse       String
  codePostal    String
  commune       String
  telephone     String

  // Bloc mineurs (obligatoire si moins de 18 ans)
  responsableNom       String?
  responsableLien      String?
  responsableTelephone String?

  droitImage     Boolean
  montantPropose Decimal       @db.Decimal(8, 2)
  modeReglement  ModeReglement

  consentementLeveeAnonymat Boolean // ADH-3
  certifieLe                DateTime // case « vaut signature électronique »
  consentementRgpdLe        DateTime

  statut      StatutDemande @default(EN_ATTENTE)
  motifRefus  String?
  decideLe    DateTime?
  decidePar   Membre?       @relation("DemandesDecidees", fields: [decideParId], references: [id])
  decideParId String?

  membre   Membre? @relation("DemandeDuMembre", fields: [membreId], references: [id])
  membreId String? @unique

  acceptations Acceptation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statut, createdAt])
  @@index([email])
}

// ---------- Membres et identité ----------

// Identité privée : visible uniquement des administrateurs habilités (section 6.2).
model Membre {
  id    String @id @default(cuid())
  email String @unique

  motDePasseHash String?

  nom           String
  prenom        String
  dateNaissance DateTime? @db.Date
  adresse       String?
  codePostal    String?
  commune       String?
  telephone     String?

  responsableNom       String?
  responsableLien      String?
  responsableTelephone String?

  droitImage Boolean @default(false)

  categorie    CategorieMembre @default(ADHERENT)
  dateAgrement DateTime?
  statut       StatutMembre    @default(EN_ATTENTE_ACTIVATION)
  motifStatut  String?
  role         Role            @default(ADHERENT)
  peutPublier  Boolean         @default(false) // mandaté pour publier (ADM-18)

  alias Alias?

  demande          DemandeAdhesion?  @relation("DemandeDuMembre")
  demandesDecidees DemandeAdhesion[] @relation("DemandesDecidees")

  acceptations          Acceptation[]
  cotisations           Cotisation[]       @relation("CotisationsDuMembre")
  cotisationsSaisies    Cotisation[]       @relation("CotisationsSaisies")
  sessions              Session[]
  jetons                Jeton[]
  articles              Article[]
  journal               JournalAudit[]
  contenusModifies      ContenuEditorial[]
  signalements          SignalementBug[]
  messagesRepondus      MessageContact[]
  inscriptionSel        InscriptionSel?
  attestationsRc        AttestationRc[]    @relation("AttestationsDuMembre")
  attestationsVerifiees AttestationRc[]    @relation("AttestationsVerifiees")

  // ADH-10 : date du dernier rappel de cotisation envoyé (évite les relances quotidiennes)
  dernierRappelCotisation DateTime?

  derniereConnexion DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([statut])
  @@index([nom, prenom])
}

// Alias public (code personnel unique). Seul élément public d'un adhérent.
// Table séparée de l'identité : les futures tables du SEL ne référenceront que l'alias.
model Alias {
  id       String @id @default(cuid())
  code     String @unique
  membre   Membre @relation(fields: [membreId], references: [id], onDelete: Cascade)
  membreId String @unique

  // SEL : solde en briques (1 minute = 1 brique), mis à jour avec chaque transaction (SEL-9, RG-8)
  soldeBriques    Int  @default(0)
  // Dérogation accordée par un administrateur : solde minimum autorisé (sinon -120, SEL-22)
  plancherBriques Int?

  annonces             Annonce[]
  conversationsAuteur  Conversation[]       @relation("ConversationAuteur")
  conversationsContact Conversation[]       @relation("ConversationInterlocuteur")
  messages             Message[]
  echangesBeneficiaire Echange[]            @relation("EchangeBeneficiaire")
  echangesPrestataire  Echange[]            @relation("EchangePrestataire")
  transactionsDebit    TransactionBriques[] @relation("TransactionDebit")
  transactionsCredit   TransactionBriques[] @relation("TransactionCredit")
  signalementsSel      SignalementSel[]

  createdAt DateTime @default(now())
}

// ---------- Textes juridiques et acceptations ----------

model TexteJuridique {
  id          String    @id @default(cuid())
  type        TypeTexte
  titre       String
  version     String
  contenu     String    @db.Text // texte complet affiché au-dessus de la case
  fichierUrl  String? // PDF téléchargeable
  enVigueurLe DateTime

  acceptations Acceptation[]

  createdAt DateTime @default(now())

  @@unique([type, version])
  @@index([type, enVigueurLe])
}

// Preuve d'acceptation (RG-21) : texte + version + horodatage.
// Rattachée à la demande au dépôt, puis au membre à la validation.
model Acceptation {
  id String @id @default(cuid())

  texte   TexteJuridique @relation(fields: [texteId], references: [id])
  texteId String

  demande   DemandeAdhesion? @relation(fields: [demandeId], references: [id])
  demandeId String?
  membre    Membre?          @relation(fields: [membreId], references: [id])
  membreId  String?

  accepteLe DateTime @default(now())

  @@index([membreId])
  @@index([demandeId])
}

// ---------- Cotisations ----------

// Saisie manuelle par un membre du Bureau (ADH-13, RG-27). Aucun paiement en ligne.
model Cotisation {
  id            String        @id @default(cuid())
  membre        Membre        @relation("CotisationsDuMembre", fields: [membreId], references: [id])
  membreId      String
  montant       Decimal       @db.Decimal(8, 2)
  modeReglement ModeReglement
  recueLe       DateTime      @db.Date
  valideJusquau DateTime      @db.Date
  saisiePar     Membre        @relation("CotisationsSaisies", fields: [saisieParId], references: [id])
  saisieParId   String

  createdAt DateTime @default(now())

  @@index([membreId, valideJusquau])
}

// ---------- Authentification ----------

model Session {
  id        String   @id // hachage du jeton stocké dans le cookie
  membre    Membre   @relation(fields: [membreId], references: [id], onDelete: Cascade)
  membreId  String
  expireLe  DateTime
  createdAt DateTime @default(now())

  @@index([membreId])
}

// Lien d'activation ou de réinitialisation : à usage unique, durée limitée (ADH-7).
model Jeton {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  type        TypeJeton
  membre      Membre    @relation(fields: [membreId], references: [id], onDelete: Cascade)
  membreId    String
  expireLe    DateTime
  nouvelEmail String? // CHANGEMENT_EMAIL : adresse à confirmer
  utiliseLe   DateTime?
  createdAt   DateTime  @default(now())
}

// ---------- Contenus ----------

// Blocs éditoriaux modifiables depuis la console (ADM-3, PRE-4), ex. « accueil.intro ».
model ContenuEditorial {
  id           String   @id @default(cuid())
  cle          String   @unique
  titre        String?
  contenu      String   @db.Text
  modifiePar   Membre?  @relation(fields: [modifieParId], references: [id])
  modifieParId String?
  updatedAt    DateTime @updatedAt
}

// Actualités et galerie (P9).
model Article {
  id           String        @id @default(cuid())
  slug         String        @unique
  titre        String
  extrait      String?
  contenu      String        @db.Text
  categorie    String // événement, atelier, solidarité…
  dateActivite DateTime?
  statut       StatutArticle @default(BROUILLON)
  publieLe     DateTime?
  auteur       Membre        @relation(fields: [auteurId], references: [id])
  auteurId     String

  medias Media[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statut, publieLe])
}

model Media {
  id                      String   @id @default(cuid())
  url                     String
  legende                 String?
  credit                  String?
  texteAlternatif         String // obligatoire (ACT-9)
  autorisationPublication Boolean  @default(false) // droit à l'image (ACT-8)
  article                 Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)
  articleId               String?
  ordre                   Int      @default(0)
  importeLe               DateTime @default(now())
}

// Services de « Nos Fabrications » (P5, FAB-2) : cartes affichées sur l'accueil et dans l'espace adhérent.
model Fabrication {
  id          String   @id @default(cuid())
  nom         String
  description String   @db.Text
  etat        String // libellé affiché : « Ouvert », « Bientôt », « À venir »…
  couleur     String   @default("bleu") // bleu | terracotta | vert | ocre
  lien        String? // page du service, ex. « /sel »
  ordre       Int      @default(0)
  visible     Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

// Messages reçus via Contacts (P8, ADM-4).
model MessageContact {
  id        String        @id @default(cuid())
  nom       String
  email     String
  telephone String?
  sujet     String?
  texte     String        @db.Text
  statut    StatutMessage @default(NOUVEAU)
  createdAt DateTime      @default(now())

  // Réponse envoyée depuis la console, au nom de l'association (CTC-2)
  reponse      String?   @db.Text
  reponduLe    DateTime?
  reponduPar   Membre?   @relation(fields: [reponduParId], references: [id], onDelete: SetNull)
  reponduParId String?

  @@index([statut, createdAt])
}

// Bouton « Signaler un bug », présent sur toutes les pages.
enum StatutSignalement {
  NOUVEAU
  EN_COURS
  RESOLU
  IGNORE
}

model SignalementBug {
  id          String            @id @default(cuid())
  description String            @db.Text
  page        String // chemin de la page (jetons secrets retirés)
  navigateur  String? // user-agent
  ecran       String? // ex. « 390×844 »
  email       String? // pour recontacter un visiteur non connecté (facultatif)
  membre      Membre?           @relation(fields: [membreId], references: [id], onDelete: SetNull)
  membreId    String?
  statut      StatutSignalement @default(NOUVEAU)
  note        String? // note interne de l'administrateur
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([statut, createdAt])
}

// ---------- Traçabilité ----------

// ADM-8 : décisions d'adhésion, accès aux identités, publications, modifications sensibles.
model JournalAudit {
  id        String   @id @default(cuid())
  acteur    Membre?  @relation(fields: [acteurId], references: [id])
  acteurId  String?
  action    String // ex. « demande.validee », « membre.suspendu »
  cibleType String
  cibleId   String?
  motif     String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([cibleType, cibleId])
}

// =====================================================================
// SEL : service d'échange local (section 5 P6, sections 6 et 7)
// Toutes les tables d'échange référencent l'ALIAS, jamais l'identité (section 6.2).
// =====================================================================

enum StatutInscriptionSel {
  ACTIVE
  SUSPENDUE
}

enum StatutAttestation {
  EN_ATTENTE
  VALIDEE
  REFUSEE
}

enum TypeAnnonce {
  OFFRE
  DEMANDE
}

enum NatureAnnonce {
  SERVICE // payé au temps passé
  PRET // prêt d'objet
  DON
  OBJET // objet échangé contre des briques (valeur fixée par celui qui le propose, SEL-14)
}

enum Modalite {
  PRESENTIEL
  DISTANCE
}

enum StatutAnnonce {
  PUBLIEE
  CLOTUREE // retirée par son auteur
  MASQUEE // masquée par la modération (NEU-3)
}

enum StatutConversation {
  OUVERTE
  FERMEE // bloquée ou close par l'un des deux
}

enum StatutEchange {
  PROPOSE // créneau et lieu proposés par le bénéficiaire
  CONFIRME // créneau confirmé par celui qui rend le service
  DECLARE // service réalisé : temps passé déclaré par celui qui l'a rendu
  TERMINE // confirmé par le bénéficiaire : briques transférées
  ANNULE
  LITIGE // le bénéficiaire conteste : médiation du CA (SEL-8)
}

enum MotifSignalementSel {
  PARTISAN // contenu partisan ou électoral (NEU-4)
  PROPOS // propos discriminatoires, agressifs ou humiliants
  ARNAQUE
  DONNEES // coordonnées ou données personnelles exposées
  AUTRE
}

enum StatutSignalementSel {
  NOUVEAU
  TRAITE
}

// SEL-2, RG-11 : inscription au SEL (les acceptations de la Charte et du Règlement du SEL sont dans « Acceptation »)
model InscriptionSel {
  id              String               @id @default(cuid())
  membre          Membre               @relation(fields: [membreId], references: [id], onDelete: Cascade)
  membreId        String               @unique
  statut          StatutInscriptionSel @default(ACTIVE)
  motifSuspension String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

// SEL-21 : attestation d'assurance RC, vérifiée par un administrateur qui saisit sa date de validité ;
// le fichier est ensuite supprimé, seuls la date et le nom du vérificateur sont conservés.
model AttestationRc {
  id            String            @id @default(cuid())
  membre        Membre            @relation("AttestationsDuMembre", fields: [membreId], references: [id], onDelete: Cascade)
  membreId      String
  assureur      String
  valideJusquau DateTime          @db.Date
  fichier       String? // chemin du fichier dans le stockage privé, effacé après vérification
  fichierType   String?
  statut        StatutAttestation @default(EN_ATTENTE)
  motifRefus    String?
  verifiePar    Membre?           @relation("AttestationsVerifiees", fields: [verifieParId], references: [id], onDelete: SetNull)
  verifieParId  String?
  verifieLe     DateTime?
  createdAt     DateTime          @default(now())

  @@index([statut, createdAt])
  @@index([membreId])
}

// Rubriques du catalogue des échanges (annexe B), modifiables par un administrateur (SEL-11, ADM-10)
model RubriqueSel {
  id       String    @id @default(cuid())
  code     String    @unique
  libelle  String
  exemples String?   @db.Text
  rappel   String?   @db.Text // avertissement affiché dans la rubrique (SEL-17, SEL-24)
  ordre    Int       @default(0)
  actif    Boolean   @default(true)
  annonces Annonce[]
}

// SEL-5 : une annonce, toujours publiée sous l'alias de son auteur
model Annonce {
  id              String           @id @default(cuid())
  type            TypeAnnonce
  nature          NatureAnnonce
  rubrique        RubriqueSel      @relation(fields: [rubriqueId], references: [id])
  rubriqueId      String
  titre           String
  description     String           @db.Text
  dureeEstimee    Int? // minutes (service)
  valeurBriques   Int? // objet échangé contre des briques
  zone            String // commune ou secteur, jamais une adresse (section 6.6)
  modalite        Modalite
  disponibilites  String?
  dateFin         DateTime?        @db.Date
  motsCles        String?
  auteur          Alias            @relation(fields: [auteurId], references: [id])
  auteurId        String
  statut          StatutAnnonce    @default(PUBLIEE)
  motifModeration String?
  conversations   Conversation[]
  signalements    SignalementSel[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([type, statut, createdAt])
  @@index([auteurId])
}

// MSG-1 à MSG-3 : une conversation lie exactement deux alias, autour d'une annonce
model Conversation {
  id                    String             @id @default(cuid())
  annonce               Annonce            @relation(fields: [annonceId], references: [id])
  annonceId             String
  auteur                Alias              @relation("ConversationAuteur", fields: [auteurId], references: [id])
  auteurId              String // auteur de l'annonce
  interlocuteur         Alias              @relation("ConversationInterlocuteur", fields: [interlocuteurId], references: [id])
  interlocuteurId       String
  statut                StatutConversation @default(OUVERTE)
  fermeeParId           String?
  // Levée d'anonymat (section 6.5) : accord de chaque partie, irréversible
  accordAuteurLe        DateTime?
  accordInterlocuteurLe DateTime?
  messages              Message[]
  echanges              Echange[]
  signalements          SignalementSel[]
  dernierMessageLe      DateTime           @default(now())
  createdAt             DateTime           @default(now())

  @@unique([annonceId, interlocuteurId])
  @@index([auteurId, dernierMessageLe])
  @@index([interlocuteurId, dernierMessageLe])
}

model Message {
  id             String           @id @default(cuid())
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  emetteur       Alias            @relation(fields: [emetteurId], references: [id])
  emetteurId     String
  texte          String           @db.Text
  luLe           DateTime?
  signalements   SignalementSel[]
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
}

// Réservation puis clôture d'un échange (support de la monnaie)
model Echange {
  id               String              @id @default(cuid())
  conversation     Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId   String
  beneficiaire     Alias               @relation("EchangeBeneficiaire", fields: [beneficiaireId], references: [id])
  beneficiaireId   String
  prestataire      Alias               @relation("EchangePrestataire", fields: [prestataireId], references: [id])
  prestataireId    String
  nature           NatureAnnonce
  // Réservation : proposée par le bénéficiaire, confirmée par le prestataire
  creneau          DateTime
  lieu             String
  confirmeLe       DateTime?
  // Déclaration par le prestataire une fois le service rendu
  dureeMinutes     Int?
  briques          Int? // montant transféré (durée pour un service, valeur pour un objet, 0 pour un prêt ou un don)
  bienPasse        Boolean?
  commentaire      String?
  declareLe        DateTime?
  // Confirmation par le bénéficiaire
  avisBeneficiaire String?
  termineLe        DateTime?
  statut           StatutEchange       @default(PROPOSE)
  annulePar        String? // alias qui a annulé ou contesté
  motifAnnulation  String?
  transaction      TransactionBriques?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([beneficiaireId, statut])
  @@index([prestataireId, statut])
}

// Grand livre des briques : chaque mouvement est conservé (débit et crédit)
model TransactionBriques {
  id        String   @id @default(cuid())
  echange   Echange? @relation(fields: [echangeId], references: [id])
  echangeId String?  @unique
  montant   Int
  debite    Alias?   @relation("TransactionDebit", fields: [debiteId], references: [id])
  debiteId  String? // null : compte d'urgence et de solidarité de l'association
  credite   Alias?   @relation("TransactionCredit", fields: [crediteId], references: [id])
  crediteId String?
  libelle   String
  createdAt DateTime @default(now())

  @@index([debiteId, createdAt])
  @@index([crediteId, createdAt])
}

// MSG-7, NEU-4 : signalement d'un message, d'une annonce ou d'une conversation
model SignalementSel {
  id             String               @id @default(cuid())
  signaleur      Alias                @relation(fields: [signaleurId], references: [id])
  signaleurId    String
  annonce        Annonce?             @relation(fields: [annonceId], references: [id], onDelete: Cascade)
  annonceId      String?
  conversation   Conversation?        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String?
  message        Message?             @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId      String?
  motif          MotifSignalementSel
  details        String?
  statut         StatutSignalementSel @default(NOUVEAU)
  note           String?
  createdAt      DateTime             @default(now())

  @@index([statut, createdAt])
}
